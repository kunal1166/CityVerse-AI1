# ===== CityVerse AI - Backend =====
# Copy to .env.local and fill in what you need. Runs fine with nothing set.

# Which frontend origin may call this API. Use your deployed frontend URL in prod.
FRONTEND_ORIGIN=http://localhost:5173

# Server port
PORT=3000

# --- AI (optional) ---  Groq free key: https://console.groq.com/keys
AI_PROVIDER=groq
GROQ_API_KEY=

# --- Live traffic (optional) --- https://developer.tomtom.com
TOMTOM_API_KEY=

# --- Gemini (used by /api/agent/analyze-environment) ---
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
